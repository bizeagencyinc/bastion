# BASTION TEMPLATE: .env.example
# Commit this file with NAMES ONLY. Never commit real values (SEC-06).
# Real values live in your secrets manager or hosting platform environment settings.

# App
NODE_ENV=production
APP_URL=

# Database (runtime user, least privilege: DATA-02)
DATABASE_URL=

# Auth
AUTH_SECRET=

# Payments (server only, never NEXT_PUBLIC_: PAY-11)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Supabase (anon key is public and protected by RLS; service role is server only: BAAS-03)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI providers (server only)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Email
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
