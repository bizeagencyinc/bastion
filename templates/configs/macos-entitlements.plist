<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  BASTION TEMPLATE | Minimal sandboxed macOS app entitlements
  Rules: MAC-03, MAC-04
  Add only what the app truly needs. Each extra entitlement must be justified in code review.
-->
<plist version="1.0">
<dict>
    <key>com.apple.security.app-sandbox</key>
    <true/>
    <!-- Outgoing network connections (API calls) -->
    <key>com.apple.security.network.client</key>
    <true/>
    <!-- Files the user explicitly opens or saves -->
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>
    <!--
      Avoid unless strictly required (document why):
      com.apple.security.cs.disable-library-validation
      com.apple.security.cs.allow-unsigned-executable-memory
      com.apple.security.cs.allow-dyld-environment-variables
      com.apple.security.network.server
      com.apple.security.files.downloads.read-write
    -->
</dict>
</plist>
