    "prepack": "node scripts/sync-data.js",
    "test": "node --test test/*.test.js",
    "start": "node src/index.js",
    "self-test": "node src/index.js --self-test",
    "build:plugin": "node scripts/build-plugin.js"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "security",
    "appsec",
    "owasp",
