{
  "name": "bastion-security-mcp",
  "version": "2.3.0",
  "description": "Bastion: 680+ security rules for AI coding agents as a read-only MCP server. Claude Code, Cursor, Copilot, VS Code.",
  "mcpName": "io.github.bizeagencyinc/bastion",
  "type": "module",
  "bin": {
    "bastion-mcp": "src/index.js",
    "bastion-security-mcp": "src/index.js"
  },
  "main": "src/index.js",
