  "author": "Muhammad Faisal",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bizeagencyinc/bastion.git",
    "directory": "mcp"
  },
  "homepage": "https://github.com/bizeagencyinc/bastion#readme",
  "bugs": {
    "url": "https://github.com/bizeagencyinc/bastion/issues"
  },
  "publishConfig": {
